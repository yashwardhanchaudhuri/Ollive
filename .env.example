# Copy to .env and fill in values.

# --- OSS: local vLLM for Qwen (no vendor key) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
OLLIVE_VLLM_QUANTIZATION=fp8

# --- Frontier (OpenAI) — only needed for frontier backend ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Independent runtime Security LM (required) ---
# It may share model weights with the answer model; prompts and contracts remain isolated.
SECURITY_LM_MODEL=
SECURITY_LM_API_KEY=
# SECURITY_LM_BASE_URL=https://api.openai.com/v1
# Optional stable deployment canary; leave unset to generate one at process start.
SECURITY_CANARY_TOKEN=

# --- Tools ---
# Required: every grounded wellness turn searches the authoritative-domain allowlist
TAVILY_API_KEY=

# --- Model cache (optional) ---
# Point this to a larger disk before downloading models if necessary.
# HF_HOME=/path/to/huggingface-cache


# --- Observability is local JSONL by default (data/traces/) ---
# Langfuse is optional and unused unless you switch provider in backends.yaml
